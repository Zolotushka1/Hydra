    {
      "cdn_compatible": false,
      "flow": "xtls-rprx-vision",
      "id": "<volatile>",
      "protocol": "vless",
      "rationale": "Reality hides the handshake and defeats active probing; XHTTP hides the connection profile that follows it. Cost: stream-one is the slowest XHTTP mode.",
      "recommended": true,
      "security": "reality",
      "title": "Direct connection, maximum stealth",
      "transport": "xhttp",
      "xhttp_mode": "stream-one"
    },
    {
      "cdn_compatible": false,
      "flow": "xtls-rprx-vision",
      "id": "<volatile>",
      "protocol": "vless",
      "rationale": "Vision over TCP splices on Linux and is markedly cheaper on CPU, which matters at 1 vCPU. Cost: the post-handshake connection profile is not disguised.",
      "recommended": false,
      "security": "reality",
      "title": "Direct connection, maximum throughput",
      "transport": "tcp"
    },
    {
      "cdn_compatible": true,
      "id": "<volatile>",
      "protocol": "vless",
      "rationale": "packet-up is the only mode guaranteed to pass through a CDN or Nginx. Reality does not apply there because the intermediary terminates TLS, and Vision is incompatible with packet-up.",
      "recommended": false,
      "security": "tls",
      "title": "Behind a CDN",
      "transport": "xhttp",
      "xhttp_mode": "packet-up"
    }
