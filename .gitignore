# Build output
target/
.target/
debug/
dist/
**/*.rs.bk
*.pdb
**/mutants.out*/
panel/web/node_modules
panel/web/dist
# TypeScript incremental build cache and the compiled form of vite.config.ts.
*.tsbuildinfo
panel/web/vite.config.js
panel/web/vite.config.d.ts

# Local data and secrets.
#
# The panel keeps the Argon2 admin hash, the encrypted 2FA secret, node tokens,
# encryption master keys and route material here; the agent keeps its state, the
# credential manifest and WireGuard private keys. Both directories are recreated
# on start and have no place in the repository.
data/
.smoke/
# Frontend development state, created by web-leptos/scripts/dev.sh. Same
# contents as data/: an admin hash, seeded users, the audit log.
.dev-leptos/

# Secret material anywhere: master keys, TLS private keys, certificates. Broader
# than data/ on purpose, in case someone runs with different paths via
# HYDRA_*_PATH.
*.key
*.pem
*.crt
*.p12
*.pfx
node.env
.env
.env.*

# Working notes for coding agents. Product documentation belongs in docs/; these
# files also carry priorities, execution order and environment specifics that are
# not part of the product.
AGENTS.md

# Editor and IDE state
.idea
.vscode
